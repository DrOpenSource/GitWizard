{
  "name": "gitwizard",
  "displayName": "GitWizard",
  "description": "Intent-based Git safety and orchestration extension for vibe coders",
  "version": "1.0.0",
  "icon": "assets/icon.png",
  "publisher": "dr-opensource",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "license": "MIT",
  "author": "Dr. Shubham Kashyap",
  "homepage": "https://github.com/DrOpenSource/GitWizard#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/DrOpenSource/GitWizard.git"
  },
  "bugs": {
    "url": "https://github.com/DrOpenSource/GitWizard/issues"
  },
  "keywords": [
    "git",
    "undo",
    "checkpoint",
    "ai-coding",
    "source-control",
    "safety"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:gitwizard.sidebarView"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gitwizard-sidebar",
          "title": "GitWizard",
          "icon": "$(wand)"
        }
      ]
    },
    "views": {
      "gitwizard-sidebar": [
        {
          "type": "webview",
          "id": "gitwizard.sidebarView",
          "name": "GitWizard Assistant"
        }
      ]
    },
    "commands": [
      {
        "command": "gitwizard.createCheckpoint",
        "title": "GitWizard: Create Safety Checkpoint",
        "category": "GitWizard"
      },
      {
        "command": "gitwizard.restoreCheckpoint",
        "title": "GitWizard: Restore Checkpoint",
        "category": "GitWizard"
      },
      {
        "command": "gitwizard.splitChanges",
        "title": "GitWizard: Split Changes into Branches",
        "category": "GitWizard"
      },
      {
        "command": "gitwizard.safeSync",
        "title": "GitWizard: Safe Sync with Remote",
        "category": "GitWizard"
      },
      {
        "command": "gitwizard.focusSidebar",
        "title": "GitWizard: Focus Assistant Sidebar",
        "category": "GitWizard"
      },
      {
        "command": "gitwizard.undoLast",
        "title": "GitWizard: Undo Last Git Action (Time Machine)",
        "category": "GitWizard"
      },
      {
        "command": "gitwizard.splitToNewRepo",
        "title": "GitWizard: Promote Branch to New Repo",
        "category": "GitWizard"
      },
      {
        "command": "gitwizard.pushMain",
        "title": "GitWizard: Push Main to Origin",
        "category": "GitWizard"
      },
      {
        "command": "gitwizard.generateAICommit",
        "title": "GitWizard Pro: Generate AI Commit Message",
        "category": "GitWizard"
      },
      {
        "command": "gitwizard.activateLicense",
        "title": "GitWizard Pro: Activate Lifetime License",
        "category": "GitWizard"
      },
      {
        "command": "gitwizard.configureAI",
        "title": "GitWizard Pro: Configure AI Provider & Key",
        "category": "GitWizard"
      }
    ],
    "configuration": {
      "title": "GitWizard Pro",
      "properties": {
        "gitwizard.aiProvider": {
          "type": "string",
          "enum": ["gemini", "openai", "ollama"],
          "default": "gemini",
          "description": "AI provider for semantic commits and summaries."
        },
        "gitwizard.geminiApiKey": {
          "type": "string",
          "default": "",
          "description": "Google Gemini API key for GitWizard Pro AI features."
        },
        "gitwizard.openaiApiKey": {
          "type": "string",
          "default": "",
          "description": "OpenAI API key for GitWizard Pro AI features."
        },
        "gitwizard.ollamaBaseUrl": {
          "type": "string",
          "default": "http://localhost:11434",
          "description": "Base URL for local Ollama endpoint."
        },
        "gitwizard.ollamaModel": {
          "type": "string",
          "default": "llama3.2",
          "description": "Model tag for local Ollama instance."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.20.0",
    "ovsx": "^1.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.1"
  }
}
